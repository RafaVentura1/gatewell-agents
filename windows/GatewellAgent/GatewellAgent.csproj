<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GatewellAgent</AssemblyName>
    <RootNamespace>GatewellAgent</RootNamespace>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      CI publishes with:
        see build-windows.yml for the exact publish flags

      The RID is supplied on the command line rather than pinned here so the
      project still restores and builds on a non-Windows machine for syntax
      validation.
    -->
    <!-- PublishSingleFile is passed on the publish command line, not set
         here: setting it in the project pulls Microsoft.NET.ILLink.Tasks at
         restore time, which would require a package source. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    ZERO PackageReference entries by design.

    Everything that would normally need a NuGet package is done through
    P/Invoke against the OS instead, so the agent depends only on the BCL:

      Microsoft.Extensions.Hosting.WindowsServices  ->  advapi32 SCM APIs
      System.Security.Cryptography.ProtectedData    ->  crypt32 CryptProtectData
      System.Diagnostics.EventLog                   ->  advapi32 ReportEvent
      Microsoft.Win32.Registry                      ->  advapi32 Reg* APIs

    This also means the project restores with no network access at all.
  -->

</Project>
