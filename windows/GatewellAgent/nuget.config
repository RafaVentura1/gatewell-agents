<?xml version="1.0" encoding="utf-8"?>
<!--
  The project has zero PackageReference entries, so `dotnet build` needs no
  package source at all and works fully offline.

  A source is still required when publishing a self contained win-x64 build,
  which downloads the win-x64 runtime pack. nuget.org is pinned explicitly so
  CI restores are deterministic rather than depending on machine level config.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
